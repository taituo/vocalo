{
  "agent": {
    "command": "/Users/YOU/.local/bin/kiro-cli",
    "args": ["acp", "--agent-engine=v3"],
    "model": null,
    "effortLevel": "low",
    "mode": null,
    "additionalDirectories": []
  },
  "cwd": "/Users/YOU/code/some-project",

  "remote_example_rename_to_remote_to_enable": {
    "host": "me@devbox",
    "port": 22,
    "identityFile": null,
    "cwd": "/home/me/code/some-project",
    "command": "~/.local/bin/kiro-cli",
    "env": { "KIRO_LOG_LEVEL": "info" },
    "sshOptions": []
  },

  "speech": { "url": "ws://127.0.0.1:8765", "spawn": true },
  "ui": { "aspect": "16:9", "eventsPort": 8766 },
  "conversation": { "mode": "vad", "bargeIn": true, "permissions": "ask", "busyPolicy": "steer", "verbosity": "short", "narrateEveryMs": 7000, "preamble": true, "defaultLang": "fi", "fillerAfterMs": 1400 },
  "talker": {
    "url": "http://127.0.0.1:8080/v1",
    "model": "mlx-community/Qwen3-4B-Instruct-2507-4bit",
    "apiKeyEnv": null,
    "ackDeadlineMs": 900
  },
  "control": { "autoCompactAt": 85, "speakConfirmations": false },
  "metricsFile": null
}
